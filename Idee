from scipy.integrate import odeint

class AIDN_Network_Bifurcation:
    """
    Réseau réduit de 2 A.I.D.N. couplés (Section 9.1 du document)
    Modélisation de la bifurcation de Hopf induite par le paramètre mu.
    """
    def __init__(self, mu_initial=-0.5):
        self.mu = mu_initial  # Paramètre de bifurcation (influence du prompt u(t))
        self.omega = 1.0      # Fréquence propre
        self.dt = 0.01
        self.time = np.arange(0, 50, self.dt)

    def system_dynamics(self, state, t, mu):
        """
        Équations d'état (Forme normale de Hopf supercritique)
        x1 : Intention / x2 : Cohérence
        """
        x1, x2 = state
        
        # Termes non linéaires (Coefficients de Landau / Section 4.3)
        radius_sq = x1**2 + x2**2
        
        dx1_dt = mu * x1 - self.omega * x2 - x1 * radius_sq
        dx2_dt = self.omega * x1 + mu * x2 - x2 * radius_sq
        
        return [dx1_dt, dx2_dt]

    def run_simulation(self):
        # État initial (légèrement décalé du point d'équilibre 0,0)
        initial_state = [0.1, 0.0]
        
        # 1. Simulation état stable (mu < 0)
        mu_stable = -0.5
        sol_stable = odeint(self.system_dynamics, initial_state, self.time, args=(mu_stable,))
        
        # 2. Simulation post-bifurcation (mu > 0)
        mu_unstable = 0.5
        sol_unstable = odeint(self.system_dynamics, initial_state, self.time, args=(mu_unstable,))
        
        return sol_stable, sol_unstable


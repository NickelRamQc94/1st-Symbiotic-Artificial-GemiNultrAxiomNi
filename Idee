```structuredtext
PROGRAM GestionEau
VAR
    Water_Tank_Level : REAL;          // Niveau d'eau mesuré (par capteur)
    Process_Phase    : INT;            // Phase actuelle du processus
    Valve_Open       : BOOL;           // Commande de la vanne
    High_Level       : REAL := 80.0;   // Seuil haut
    Low_Level        : REAL := 20.0;   // Seuil bas
END_VAR

// Logique de remplissage/vidage
IF Process_Phase = 2 THEN   // Phase de remplissage
    IF Water_Tank_Level < High_Level THEN
        Valve_Open := TRUE;
    ELSE
        Valve_Open := FALSE;
    END_IF
ELSIF Process_Phase = 3 THEN // Phase de vidange
    IF Water_Tank_Level > Low_Level THEN
        Valve_Open := TRUE;  // Supposons que la vanne s'ouvre pour vidanger
    ELSE
        Valve_Open := FALSE;
    END_IF
ELSE
    Valve_Open := FALSE;
END_IF
```


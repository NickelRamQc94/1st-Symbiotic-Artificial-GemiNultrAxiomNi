```vhdl
-- Registre 8 bits avec entrée de validation
entity registre is
    port (
        clk     : in std_logic;
        reset   : in std_logic;
        en      : in std_logic;
        data_in : in std_logic_vector(7 downto 0);
        data_out: out std_logic_vector(7 downto 0)
    );
end registre;

architecture behavioral of registre is
begin
    process(clk, reset)
    begin
        if reset = '1' then
            data_out <= (others => '0');
        elsif rising_edge(clk) then
            if en = '1' then
                data_out <= data_in;
            end if;
        end if;
    end process;
end behavioral;
```

